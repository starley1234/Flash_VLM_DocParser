# ============================================================
# Flash-VLM DocParser — пример конфигурации (.env)
# Скопируйте в .env и при необходимости измените значения.
# Все переменные имеют префикс FLASH_VLM_.
# ============================================================

# --- LM Studio (OpenAI-совместимый API) --------------------
# Адрес сервера LM Studio. По умолчанию http://localhost:1234/v1
# Внутри Docker используйте http://host.docker.internal:1234/v1
FLASH_VLM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Ключ API (LM Studio принимает любое непустое значение)
FLASH_VLM_LMSTUDIO_API_KEY=lm-studio
# Конкретная модель. Пусто = автоопределение первой доступной
FLASH_VLM_MODEL=
# Температура и лимит токенов
FLASH_VLM_TEMPERATURE=0.0
FLASH_VLM_MAX_TOKENS=4096
FLASH_VLM_REQUEST_TIMEOUT=300.0

# --- Рендеринг страниц --------------------------------------
# Ширина изображения, отправляемого в VLM (по умолчанию 512)
FLASH_VLM_IMAGE_WIDTH=512
# DPI при рендеринге PDF (до ресайза)
FLASH_VLM_RENDER_DPI=200
# Бэкенд рендеринга: pymupdf (по умолчанию) или pdf2image
FLASH_VLM_RENDER_BACKEND=pymupdf
# Формат изображения для VLM: png или jpeg
FLASH_VLM_IMAGE_FORMAT=png

# --- Пайплайн / очередь -------------------------------------
# Количество параллельных запросов к VLM (1 для 16 ГБ VRAM)
FLASH_VLM_CONCURRENCY=1
FLASH_VLM_MAX_RETRIES=3
FLASH_VLM_RETRY_BACKOFF=2.0
FLASH_VLM_QUEUE_SIZE=32

# --- Вывод и кеширование ------------------------------------
FLASH_VLM_USE_CACHE=true
FLASH_VLM_CACHE_DIR=.cache/flash_vlm
FLASH_VLM_OUTPUT_DIR=output
FLASH_VLM_PAGE_MARKERS=false
FLASH_VLM_ADD_FRONTMATTER=true

# --- HTTP API -----------------------------------------------
FLASH_VLM_API_HOST=0.0.0.0
FLASH_VLM_API_PORT=8000
FLASH_VLM_MAX_UPLOAD_MB=100

# --- Демо-режим без LM Studio --------------------------------
# true = использовать встроенную заглушку VLM (для тестов/CI)
FLASH_VLM_FAKE_VLM=false
